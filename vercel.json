{
  "buildCommand": "SAYAD_SERVERLESS=1 npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "dist/server-fn.cjs" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!assets/|pdfjs/|vendor/|icons/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(index.html|sw.js|manifest.json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
